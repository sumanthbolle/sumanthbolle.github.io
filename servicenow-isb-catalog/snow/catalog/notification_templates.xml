<?xml version="1.0" encoding="UTF-8"?>
<!--
  Email Notification Templates for ISB Sandbox Catalog
  Create in: System Notification > Email > Notifications

  Events to register (System Policy > Events > Registry):
    - x_tema_isb.sandbox_provisioned
    - x_tema_isb.sandbox_expiry_warning
    - x_tema_isb.sandbox_released
-->
<notifications>

  <!-- ===== Notification: Sandbox Provisioned Successfully ===== -->
  <notification>
    <name>ISB - Sandbox Provisioned</name>
    <event_name>x_tema_isb.sandbox_provisioned</event_name>
    <subject>AWS Innovation Sandbox Assigned - ${event.parm1}</subject>
    <message_html><![CDATA[
<html>
<body style="font-family: Arial, sans-serif; color: #333;">
  <div style="max-width: 600px; margin: 0 auto; padding: 20px;">
    <div style="background: #232f3e; color: #fff; padding: 15px 20px; border-radius: 4px 4px 0 0;">
      <h2 style="margin: 0;">AWS Innovation Sandbox - Assigned</h2>
    </div>
    <div style="border: 1px solid #ddd; border-top: none; padding: 20px; border-radius: 0 0 4px 4px;">
      <p>Hello,</p>
      <p>Your AWS Innovation Sandbox has been successfully provisioned. Below are your access details:</p>

      <div style="background: #f5f5f5; padding: 15px; border-radius: 4px; margin: 15px 0;">
        <pre style="font-family: Consolas, monospace; white-space: pre-wrap; margin: 0;">${event.parm2}</pre>
      </div>

      <h3 style="color: #232f3e;">Quick Start Guide</h3>
      <ol>
        <li>Navigate to the <strong>AWS Access Portal URL</strong> provided above.</li>
        <li>Sign in with your <strong>corporate credentials</strong> (SSO).</li>
        <li>Select your assigned sandbox account.</li>
        <li>Choose a role and launch the <strong>Management Console</strong>.</li>
      </ol>

      <div style="background: #fff3cd; border: 1px solid #ffc107; padding: 10px; border-radius: 4px; margin: 15px 0;">
        <strong>Important:</strong> This sandbox is for experimentation only.
        Do NOT store production data or PII. Resources will be cleaned up upon lease expiration.
      </div>

      <p>For questions or issues, contact the <a href="mailto:cloud-platform@company.com">Cloud Platform Team</a>.</p>

      <p style="color: #666; font-size: 12px; margin-top: 20px;">
        RITM: ${URI_REF}<br/>
        This is an automated notification from the ServiceNow ISB Catalog.
      </p>
    </div>
  </div>
</body>
</html>
    ]]></message_html>
    <recipients>
      <recipient type="event_parm1"/>
    </recipients>
    <active>true</active>
  </notification>

  <!-- ===== Notification: Sandbox Expiry Warning ===== -->
  <notification>
    <name>ISB - Sandbox Expiry Warning</name>
    <event_name>x_tema_isb.sandbox_expiry_warning</event_name>
    <subject>${event.parm2.split('|||')[0]}</subject>
    <message_html><![CDATA[
<html>
<body style="font-family: Arial, sans-serif; color: #333;">
  <div style="max-width: 600px; margin: 0 auto; padding: 20px;">
    <div style="background: #ff9900; color: #fff; padding: 15px 20px; border-radius: 4px 4px 0 0;">
      <h2 style="margin: 0;">Sandbox Lease Expiring Soon</h2>
    </div>
    <div style="border: 1px solid #ddd; border-top: none; padding: 20px; border-radius: 0 0 4px 4px;">
      <pre style="font-family: Consolas, monospace; white-space: pre-wrap;">${event.parm2.split('|||')[1]}</pre>
    </div>
  </div>
</body>
</html>
    ]]></message_html>
    <recipients>
      <recipient type="event_parm1"/>
    </recipients>
    <active>true</active>
  </notification>

</notifications>
